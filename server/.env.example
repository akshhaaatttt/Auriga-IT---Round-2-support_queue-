# HTTP port for the API server
PORT=3001
# SQLite database file (relative to the server/ directory or absolute)
DATABASE_PATH=data/support_queue.db
# Comma-separated list of origins allowed to call the API cross-origin.
# Not needed in development (Vite proxies /api) or production (same origin).
CORS_ORIGINS=
# Automated priority escalation (runs inside the API process)
ESCALATION_ENABLED=true
ESCALATION_INTERVAL_MS=60000
